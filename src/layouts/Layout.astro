---
/**
 * Base HTML layout for every page.
 * Pulls site-wide metadata from src/data/site.js.
 */
import { site } from "../data/site.js";
import AuthModal from "../components/AuthModal.svelte";
import MyOrdersDrawer from "../components/MyOrdersDrawer.svelte";
import ProductQuickViewModal from "../components/ProductQuickViewModal.svelte";
import InstallAppBanner from "../components/InstallAppBanner.svelte";
import "../styles/global.css";

interface Props {
  /** Page title — appended after site name */
  title?: string;
  /** Meta description override */
  description?: string;
  /** OG image path override (relative to domain) */
  ogImage?: string;
  /** Prevent search engine indexing (e.g. /admin, /cart, 404) */
  noindex?: boolean;
  /** OpenGraph type override */
  ogType?: string;
}

const {
  title,
  description = site.description,
  ogImage = site.ogImage,
  noindex = false,
  ogType = site.ogType || "website",
} = Astro.props;

const pageTitle = title
  ? title.toLowerCase().includes(site.name.toLowerCase())
    ? title
    : `${title} — ${site.name}`
  : site.name;
const canonicalUrl = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
const ogMimeType = ogImage.endsWith(".png") ? "image/png" : "image/jpeg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <!-- SEO & Crawling -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hyper-Local Geo Targeting (Whitefield / Kadugodi, Bengaluru) -->
    <meta name="geo.region" content="IN-KA" />
    <meta name="geo.placename" content="Kadugodi, Whitefield, Bengaluru" />
    <meta name="geo.position" content="12.9982;77.7609" />
    <meta name="ICBM" content="12.9982, 77.7609" />

    <!-- Open Graph for WhatsApp & Instagram -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={site.ogTitle || pageTitle} />
    <meta property="og:description" content={site.ogDescription || description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogMimeType} />
    {ogImage === "/og-share.jpg" && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.ogLocale || "en_IN"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts — preconnect for speed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Playfair+Display:wght@400;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- Theme colour for mobile browsers -->
    <meta name="theme-color" content="#2B5A16" />

    <!-- Progressive Web App (PWA) Manifest & Apple Touch Icons -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Only Superfoods" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Leaflet Map CSS for Delivery Zone -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      crossorigin=""
    />

    <!-- Razorpay Checkout Integration -->
    <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <!-- PWA Service Worker Registration (HTTPS production only; clean up on localhost dev) -->
    <script is:inline>
      if (typeof window !== 'undefined' && 'serviceWorker' in navigator) {
        var isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
        if (isLocal) {
          navigator.serviceWorker.getRegistrations().then(function(regs) {
            regs.forEach(function(reg) { reg.unregister(); });
          });
          if ('caches' in window) {
            caches.keys().then(function(keys) {
              keys.forEach(function(k) {
                if (k.indexOf('osf-cache') === 0) caches.delete(k);
              });
            });
          }
        } else if (window.location.protocol === 'https:') {
          window.addEventListener('load', function() {
            navigator.serviceWorker.register('/sw.js').catch(function(err) {
              console.warn('SW registration notice:', err);
            });
          });
        }
      }
    </script>
  </head>

  <body class="min-h-screen">
    <slot />

    <!-- Global Customer Auth, Past Orders, QuickView & PWA Install Modals -->
    <AuthModal client:load />
    <MyOrdersDrawer client:load />
    <ProductQuickViewModal client:load />
    <InstallAppBanner client:load />
  </body>
</html>
